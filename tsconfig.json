{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts"],

  "exclude": ["src/__tests__/**", "**/*.test.ts", "dist", "node_modules", "scripts"]
}
